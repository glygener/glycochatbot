HF_TOKEN=hf_your_token_here
GROQ_API_KEY=gsk_your_groq_key_here
OPENAI_API_KEY=sk_your_openai_key_here

# Chat LLM selector. Must match a key in config/llms.json.
# free    = Groq openai/gpt-oss-20b (default if unset)
# openai  = OpenAI gpt-4o (paid; requires OPENAI_API_KEY)
LLM_OPTION=free

# Streamlit UI -> FastAPI backend (local)
GLYGEN_API_URL=http://127.0.0.1:8000

# Postgres (local host when Postgres runs in Docker with port 5432 published)
DATABASE_URL=postgresql://glyco:glyco@127.0.0.1:5433/glycochat

# JWT signing secret for username login tokens
AUTH_SECRET=glycochat-dev-secret-change-me-32b

# Docker: set by compose (do not set for local embedded Chroma)
# CHROMA_HOST=chromadb
# CHROMA_PORT=8000

# Docker ingestion: path to PDF inside container
# PDF_PATH=/data/book.pdf

# Docker backend: chroma fallback directory
# DATA_DIR=/app/data
