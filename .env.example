HF_TOKEN=hf_your_token_here
GROQ_API_KEY=gsk_your_groq_key_here
OPENAI_API_KEY=sk_your_openai_key_here

# Chat LLM selector. Must match a key in config/llms.json.
# free    = Groq openai/gpt-oss-20b (default if unset)
# openai  = OpenAI gpt-4o-mini (paid; requires OPENAI_API_KEY)
LLM_OPTION=free

# Streamlit UI -> FastAPI backend
GLYGEN_API_URL=http://127.0.0.1:8000

# Docker: set by compose (do not set for local embedded Chroma)
# CHROMA_HOST=chromadb
# CHROMA_PORT=8000

# Docker ingestion: path to PDF inside container
# PDF_PATH=/data/book.pdf

# Docker backend: SQLite and local chroma fallback directory
# DATA_DIR=/app/data
