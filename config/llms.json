    "openai": {
      "display_name": "OpenAI (paid)",
      "provider": "openai",
      "model": "gpt-4o-mini",
      "temperature": 0.0,
      "chunk_size": 1000,
      "chunk_overlap": 200,
      "top_k_retrieval": 20,
      "top_k_rerank": 5,
      "min_rerank_score": -2.0,
      "ranking_strategy": "bge",
      "prompt_dir": "prompts/openai"
